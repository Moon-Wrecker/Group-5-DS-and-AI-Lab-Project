    "hist_med(axes[0,1], df[\"height\"], \"Height (px)\", \"#9b59b6\", \"Image height\")\n",
    "hist_med(axes[0,2], df[\"kb\"].clip(upper=500), \"KB (clipped 500)\", \"#2ecc71\", \"File size\")\n",
    "hist_med(axes[1,0], df[\"aspect\"], \"W/H\",         \"#f39c12\", \"Aspect ratio\")\n",
    "axes[1,0].axvline(1.0, color=\"#3498db\", linestyle=\":\", label=\"Square\")\n",
