   "source": [
    "---\n",
    "## 15. Class Imbalance & Lorenz Curve"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "imbalance",
   "metadata": {},
   "outputs": [],
   "source": [
    "train_counts = df[df[\"split\"]==\"train\"].groupby(\"species\").size().sort_values()\n",
    "\n",
    "sorted_v = np.sort(train_counts.values)\n",
    "cum_v    = np.cumsum(sorted_v) / sorted_v.sum()\n",
    "x_sp     = np.linspace(0, 1, len(sorted_v))\n",
    "gini = 1 - 2 * np.trapz(cum_v, x_sp)\n",
    "n_eff = float(np.exp(-np.sum((train_counts/train_counts.sum()) *\n",
    "                              np.log(train_counts/train_counts.sum() + 1e-12))))\n",
    "\n",
    "fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(16, 6))\n",
    "\n",
    "ax1.plot(x_sp, cum_v, color=\"#e74c3c\", linewidth=2, label=\"All 208 species\")\n",
    "ax1.plot([0,1],[0,1],\"k--\", alpha=0.5, label=\"Perfect equality\")\n",
    "ax1.fill_between(x_sp, x_sp, cum_v, alpha=0.15, color=\"#e74c3c\")\n",
    "ax1.set_title(f\"Lorenz curve — train split\\nGini={gini:.3f}  Effective N={n_eff:.0f} classes\",\n",
    "              fontweight=\"bold\")\n",
    "ax1.set_xlabel(\"Fraction of species (poorest → richest)\")\n",
    "ax1.set_ylabel(\"Fraction of photos\"); ax1.legend()\n",
    "\n",
    "ax2.hist(np.log10(train_counts.values), bins=30, color=\"#3498db\", alpha=0.8, edgecolor=\"white\")\n",
    "ax2.axvline(np.log10(train_counts.mean()), color=\"#e74c3c\", linestyle=\"--\",\n",
    "             label=f\"Mean: {train_counts.mean():.0f}\")\n",
    "ax2.axvline(np.log10(train_counts.median()), color=\"#f39c12\", linestyle=\"--\",\n",
    "             label=f\"Median: {train_counts.median():.0f}\")\n",
    "ax2.set_xlabel(\"log10(train photos)\"); ax2.set_ylabel(\"Species count\")\n",
    "ax2.set_title(\"Training size distribution\", fontweight=\"bold\"); ax2.legend()\n",
    "\n",
    "fig.suptitle(\"Class Imbalance Analysis\", fontsize=14, fontweight=\"bold\")\n",
    "plt.tight_layout(); plt.show()\n",
    "\n",
    "print(f\"Train species:         {len(train_counts):,}\")\n",
    "print(f\"Max class (photos):    {train_counts.max():,} — {train_counts.idxmax()}\")\n",
    "print(f\"Min class (photos):    {train_counts.min():,} — {train_counts.idxmin()}\")\n",
    "print(f\"Imbalance ratio:       {train_counts.max()/train_counts.min():.0f}x\")\n",
    "print(f\"Gini index:            {gini:.3f}\")\n",
    "print(f\"Effective N classes:   {n_eff:.0f}\")"
   ]
  },
