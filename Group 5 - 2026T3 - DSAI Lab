    "print(\"=\" * 60)\n",
    "print(\"4-KEY LEAKAGE CHECK\")\n",
    "print(\"=\" * 60)\n",
    "\n",
    "checks = {}\n",
    "# Key 1: observer_id\n",
    "t_obs = set(df[df[\"split\"]==\"train\"][\"observer_id\"].dropna())\n",
    "v_obs = set(df[df[\"split\"]==\"val\"][\"observer_id\"].dropna())\n",
    "e_obs = set(df[df[\"split\"]==\"test\"][\"observer_id\"].dropna())\n",
    "checks[\"observer_id train∩val\"]  = len(t_obs & v_obs)\n",
    "checks[\"observer_id train∩test\"] = len(t_obs & e_obs)\n",
    "checks[\"observer_id val∩test\"]   = len(v_obs & e_obs)\n",
    "\n",
    "# Key 2: obs_id\n",
    "t_oid = set(df[df[\"split\"]==\"train\"][\"obs_id\"].dropna())\n",
    "v_oid = set(df[df[\"split\"]==\"val\"][\"obs_id\"].dropna())\n",
    "e_oid = set(df[df[\"split\"]==\"test\"][\"obs_id\"].dropna())\n",
    "checks[\"obs_id train∩val\"]  = len(t_oid & v_oid)\n",
    "checks[\"obs_id train∩test\"] = len(t_oid & e_oid)\n",
    "checks[\"obs_id val∩test\"]   = len(v_oid & e_oid)\n",
    "\n",
    "all_zero = True\n",
    "for key, val in checks.items():\n",
    "    status = \"✓\" if val == 0 else \"✗ LEAK\"\n",
    "    if val != 0: all_zero = False\n",
    "    print(f\"  {key:<35} {val:>6}  {status}\")\n",
    "\n",
    "print(f\"\\n  OVERALL: {'✓ ZERO LEAKAGE' if all_zero else '✗ LEAKAGE DETECTED'}\")\n",
    "\n",
    "# Temporal check\n",
    "print(\"\\nTemporal boundary (test should be 2022+):\")\n",
    "for split in [\"train\",\"val\",\"test\",\"test_extra\"]:\n",
