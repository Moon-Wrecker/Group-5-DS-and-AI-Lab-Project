    "        print(f\"  {sp:<45} {genus:<20} {cnt:>6,}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "s6hdr",
   "metadata": {},
   "source": [
    "---\n",
    "## 6. Tier & Core-27 Analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "tier",
   "metadata": {},
   "outputs": [],
   "source": [
    "tier_photos = df.groupby(\"tier\").size()\n",
    "\n",
    "fig, axes = plt.subplots(1, 3, figsize=(18, 5))\n",
    "\n",
    "tier_order  = [\"tier1\", \"tier2\", \"unknown_pool\"]\n",
    "tier_labels = [\"Tier 1\\n(>=400, 68 sp)\", \"Tier 2\\n(20-399, 140 sp)\", \"Unknown pool\\n(<20, 81 sp)\"]\n",
    "tier_colors = [\"#2ecc71\", \"#f39c12\", \"#95a5a6\"]\n",
    "vals = [tier_photos.get(t, 0) for t in tier_order]\n",
    "bars = axes[0].bar(tier_labels, vals, color=tier_colors, alpha=0.85)\n",
    "for bar in bars:\n",
