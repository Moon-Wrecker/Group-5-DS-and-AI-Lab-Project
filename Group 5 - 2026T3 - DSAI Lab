    "\n",
    "df       = pd.read_csv(base / \"splits.csv\")\n",
    "classes  = pd.read_csv(base / \"classes.csv\")\n",
    "excluded = pd.read_csv(base / \"excluded.csv\")\n",
    "\n",
    "df[\"observed_on\"] = pd.to_datetime(df[\"observed_on\"], errors=\"coerce\")\n",
