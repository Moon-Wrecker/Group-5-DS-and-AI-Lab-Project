    "axes[1,1].scatter(samp[\"width\"], samp[\"height\"], c=samp_c, alpha=0.2, s=3)\n",
    "axes[1,1].set_xlabel(\"Width\"); axes[1,1].set_ylabel(\"Height\")\n",
    "axes[1,1].set_title(\"Width vs height (5k sample)\", fontweight=\"bold\")\n",
    "\n",
    "short = df[[\"width\",\"height\"]].min(axis=1)\n",
    "thrs = [(224,\"224px\"),(256,\"256px\"),(320,\"320px\"),(500,\"500px\")]\n",
