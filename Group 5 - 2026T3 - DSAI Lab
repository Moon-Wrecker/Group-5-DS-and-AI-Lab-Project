    "              .apply(lambda x: x.mode()[0]).to_dict()\n",
    "g_colors = [WHO_COLORS.get(genus_who.get(g, \"not_listed\"), \"#2ecc71\") for g in genus_photos.index]\n",
    "ax2.bar(genus_photos.index, genus_photos.values, color=g_colors, alpha=0.85)\n",
    "ax2.set_xticklabels(genus_photos.index, rotation=45, ha=\"right\", fontsize=8)\n",
    "ax2.set_ylabel(\"Photo count\")\n",
    "ax2.set_title(\"Top-20 genera (colour = predominant WHO category)\", fontweight=\"bold\")\n",
    "ax2.yaxis.set_major_formatter(FMT)\n",
    "handles = [mpatches.Patch(color=c, label=WHO_LABELS[k]) for k, c in WHO_COLORS.items()]\n",
    "ax2.legend(handles=handles, loc=\"upper right\")\n",
    "\n",
    "fig.suptitle(\"Taxonomic Hierarchy\", fontsize=14, fontweight=\"bold\")\n",
    "plt.tight_layout(); plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "s5hdr",
   "metadata": {},
   "source": [
    "---\n",
    "## 5. WHO Safety Categories\n",
    "\n",
    "6 Category 1 (highest risk), 11 Category 2, 191 not listed."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "who",
   "metadata": {},
   "outputs": [],
   "source": [
