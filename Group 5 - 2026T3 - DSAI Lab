    "for i, fam in enumerate(top_fams):\n",
    "    if fam in [\"Viperidae\", \"Elapidae\"]:\n",
    "        ax1.axvspan(i - 0.4, i + 0.4, alpha=0.1, color=\"#e74c3c\")\n",
    "ax1.set_xticks(x); ax1.set_xticklabels(top_fams, rotation=45, ha=\"right\", fontsize=9)\n",
    "ax1.set_ylabel(\"Photo count\", color=\"#3498db\"); ax1t.set_ylabel(\"Species count\", color=\"#e74c3c\")\n",
    "ax1.set_title(\"Top-20 families: photos (bar) vs species (line)\\n* Viperidae + Elapidae = 100% venomous (red shading)\", fontweight=\"bold\")\n",
    "ax1.yaxis.set_major_formatter(FMT)\n",
    "\n",
    "# Genus bar\n",
    "genus_photos = df.groupby(\"genus\").size().sort_values(ascending=False).head(20)\n",
