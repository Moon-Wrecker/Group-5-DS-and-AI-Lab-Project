    "\n",
    "for cat in [\"1\", \"2\"]:\n",
    "    cat_sp = df[df[\"who_category\"] == cat].groupby(\"species\").size().sort_values(ascending=False)\n",
    "    print(f\"\\n── WHO Category {cat} ({len(cat_sp)} species) ──────────────────\")\n",
    "    for sp, cnt in cat_sp.items():\n",
