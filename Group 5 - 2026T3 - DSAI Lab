    "\n",
    "print(f\"splits.csv:   {len(df):,} rows x {len(df.columns)} cols\")\n",
    "print(f\"classes.csv:  {len(classes):,} rows x {len(classes.columns)} cols\")\n",
    "print(f\"excluded.csv: {len(excluded):,} rows x {len(excluded.columns)} cols\")\n",
    "print(f\"\\nColumns: {list(df.columns)}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "s1hdr",
   "metadata": {},
   "source": [
    "---\n",
    "## 1. Data Pipeline Overview\n",
    "\n",
    "From raw iNaturalist download to the final cleaned, split dataset.\n",
    "Numbers from the M2 report (29 Oct 2026)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "pipeline",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Cleaning funnel (from M2 report) ────────────────────────────────────\n",
    "pipeline = [\n",
    "    (\"Raw download\",                   182497,   0),\n",
    "    (\"Remove exact duplicates\",        181569,  928),\n",
    "    (\"Remove conflicting-species\",     181539,   30),\n",
    "    (\"Remove too small (<5KB/<100px)\", 181503,   36),\n",
    "    (\"Clean (pre-split)\",              181503,    0),\n",
    "    (\"Remove pHash near-duplicates\",   181231,  272),\n",
    "    (\"Final dataset\",                  181231,    0),\n",
    "]\n",
    "pipe_df = pd.DataFrame(pipeline, columns=[\"Stage\", \"Photos\", \"Removed\"])\n",
    "\n",
    "fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(16, 5))\n",
    "\n",
    "bar_c = [\"#3498db\" if r == 0 else \"#e74c3c\" for r in pipe_df[\"Removed\"]]\n",
    "bars  = ax1.barh(pipe_df[\"Stage\"], pipe_df[\"Photos\"], color=bar_c, alpha=0.85)\n",
    "for bar, row in zip(bars, pipe_df.itertuples()):\n",
    "    ax1.text(bar.get_width() + 300, bar.get_y() + bar.get_height()/2,\n",
    "             f\"{row.Photos:,}\", va=\"center\", fontsize=8)\n",
    "ax1.set_xlabel(\"Photo count\"); ax1.set_title(\"Cleaning pipeline — photo counts\", fontweight=\"bold\")\n",
    "ax1.xaxis.set_major_formatter(FMT); ax1.set_xlim(0, 195000); ax1.invert_yaxis()\n",
    "\n",
    "removed = pipe_df[pipe_df[\"Removed\"] > 0]\n",
    "ax2.barh(removed[\"Stage\"], removed[\"Removed\"], color=\"#e74c3c\", alpha=0.85)\n",
    "for bar, row in zip(ax2.patches, removed.itertuples()):\n",
    "    ax2.text(bar.get_width() + 5, bar.get_y() + bar.get_height()/2,\n",
    "             f\"{row.Removed:,}\", va=\"center\", fontsize=9)\n",
    "ax2.set_xlabel(\"Photos removed\"); ax2.set_title(\"Photos removed per stage\", fontweight=\"bold\")\n",
    "fig.suptitle(\"M2 Data Cleaning Pipeline\", fontsize=14, fontweight=\"bold\")\n",
    "plt.tight_layout(); plt.show()\n",
    "\n",
    "# ── Sources considered table ─────────────────────────────────────────────\n",
    "sources = pd.DataFrame([\n",
    "    (\"iNaturalist research-grade (India)\",  289,  \"181,503\", \"PRIMARY — used\"),\n",
    "    (\"India Biodiversity Portal via GBIF\",  180,  \"~1,800\",  \"HTTP 403 error\"),\n",
    "    (\"SnakeCLEF 2021 Kaggle mirror\",         -1,  \"~2,904\",  \"Deferred — 66 GB\"),\n",
    "    (\"SnakeCLEF 2023 Kaggle mirror\",        146,  \"4,989\",   \"Skipped — iNat copies\"),\n",
    "    (\"Scraped Kaggle sets (India etc.)\",     -1,  \"Unknown\", \"Skipped — unclear IP\"),\n",
    "    (\"Manna et al. 2026 OSF\",                -1,  \"793\",     \"Skipped — no labels\"),\n",
    "    (\"Open Images V7 Snake class\",           -1,  \"~309 boxes\", \"Planned M3\"),\n",
    "], columns=[\"Source\", \"Species\", \"Photos\", \"Decision\"])\n",
    "print(\"\\nData sources evaluated for M2:\")\n",
    "print(sources.to_string(index=False))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "s2hdr",
   "metadata": {},
   "source": [
    "---\n",
    "## 2. Dataset Overview\n",
    "\n",
    "Schema, missing values, and split distribution."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "overview",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Schema ──────────────────────────────────────────────────────────────\n",
    "hdr = f\"  {'Column':<22} {'Dtype':<12} {'Non-null':>10} {'% missing':>10}\"\n",
    "print(hdr)\n",
    "print(\"-\" * 58)\n",
    "for col in df.columns:\n",
    "    n_null = df[col].isna().sum()\n",
    "    pct    = n_null / len(df) * 100\n",
    "    print(f\"{col:<22} {str(df[col].dtype):<12} {len(df)-n_null:>10,} {pct:>9.1f}%\")\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(16, 5))\n",
    "\n",
    "# Missing value bars\n",
    "miss = (df.isna().sum() / len(df) * 100).sort_values(ascending=False)\n",
    "miss = miss[miss > 0]\n",
    "if len(miss) > 0:\n",
    "    axes[0].barh(miss.index, miss.values, color=\"#e74c3c\", alpha=0.8)\n",
    "    axes[0].set_xlabel(\"% missing\"); axes[0].set_title(\"Columns with missing values\", fontweight=\"bold\")\n",
    "else:\n",
    "    axes[0].text(0.5, 0.5, \"No missing values!\", ha=\"center\", va=\"center\",\n",
    "                 fontsize=16, color=\"#2ecc71\", fontweight=\"bold\", transform=axes[0].transAxes)\n",
    "    axes[0].set_title(\"Missing values check\", fontweight=\"bold\")\n",
    "\n",
    "# Split pie\n",
    "split_counts = df[\"split\"].value_counts()\n",
    "colors_s = [SPLIT_COLORS.get(s, \"#95a5a6\") for s in split_counts.index]\n",
    "axes[1].pie(split_counts.values, labels=split_counts.index, autopct=\"%1.1f%%\",\n",
    "            colors=colors_s, textprops={\"fontsize\": 9})\n",
    "axes[1].set_title(\"Split distribution\", fontweight=\"bold\")\n",
    "\n",
    "fig.suptitle(\"Dataset Schema & Split Overview\", fontsize=14, fontweight=\"bold\")\n",
    "plt.tight_layout(); plt.show()\n",
    "\n",
    "print(f\"\\nKey stats:\")\n",
    "print(f\"  Total photos:       {len(df):,}\")\n",
    "print(f\"  Species:            {df['species'].nunique():,}\")\n",
    "print(f\"  Genera:             {df['genus'].nunique():,}\")\n",
    "print(f\"  Families:           {df['family'].nunique():,}\")\n",
    "print(f\"  Observers:          {df['observer_id'].nunique():,}\")\n",
    "print(f\"  Observations:       {df['obs_id'].nunique():,}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "s3hdr",
   "metadata": {},
   "source": [
    "---\n",
    "## 3. Species Distribution\n",
    "\n",
    "Top-50 by photo count (colour = WHO category) and log-log long-tail plot."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "species",
   "metadata": {},
   "outputs": [],
   "source": [
    "species_counts = df.groupby(\"species\").size().sort_values(ascending=False)\n",
    "top50 = species_counts.head(50)\n",
    "who_map = df.drop_duplicates(\"species\").set_index(\"species\")[\"who_category\"]\n",
    "\n",
    "fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(18, 13))\n",
    "\n",
    "bar_colors = [WHO_COLORS.get(who_map.get(sp, \"not_listed\"), \"#2ecc71\") for sp in top50.index]\n",
    "ax1.barh(range(len(top50)), top50.values[::-1], color=bar_colors[::-1], alpha=0.85)\n",
    "ax1.set_yticks(range(len(top50)))\n",
    "ax1.set_yticklabels([sp.replace(\"_\", \" \") for sp in top50.index[::-1]], fontsize=7)\n",
    "ax1.set_xlabel(\"Photo count\")\n",
    "ax1.set_title(\"Top 50 species\\n(red=WHO Cat1, orange=Cat2, green=not listed)\", fontweight=\"bold\")\n",
    "ax1.xaxis.set_major_formatter(FMT)\n",
    "handles = [mpatches.Patch(color=c, label=WHO_LABELS[k]) for k, c in WHO_COLORS.items()]\n",
    "ax1.legend(handles=handles, loc=\"lower right\", fontsize=8)\n",
    "\n",
    "ranks = np.arange(1, len(species_counts) + 1)\n",
    "ax2.loglog(ranks, species_counts.values, \"o\", markersize=3, alpha=0.4, color=\"#3498db\")\n",
    "for i, (sp, cnt) in enumerate(species_counts.items()):\n",
    "    cat = who_map.get(sp, \"not_listed\")\n",
    "    if cat in [\"1\", \"2\"]:\n",
    "        ax2.loglog(i + 1, cnt, \"o\", markersize=6, color=WHO_COLORS[cat], alpha=0.9)\n",
    "ax2.set_xlabel(\"Rank (log)\"); ax2.set_ylabel(\"Photos (log)\")\n",
    "ax2.set_title(\"Rank-frequency log-log (long tail)\", fontweight=\"bold\")\n",
    "ax2.grid(True, alpha=0.3)\n",
    "ax2.legend(handles=handles, loc=\"upper right\", fontsize=8)\n",
    "\n",
    "fig.suptitle(\"Species Distribution — 208 Classes\", fontsize=14, fontweight=\"bold\")\n",
    "plt.tight_layout(); plt.show()\n",
    "\n",
    "print(\"\\nClasses below photo threshold:\")\n",
    "for t in [50, 100, 200, 400, 1000]:\n",
    "    n = (species_counts < t).sum()\n",
    "    print(f\"  < {t:>5}: {n:>4} classes  ({n/len(species_counts)*100:.1f}%)\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "s4hdr",
   "metadata": {},
   "source": [
    "---\n",
    "## 4. Taxonomic Hierarchy\n",
    "\n",
    "Families and genera — photo counts and species counts."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "taxonomy",
   "metadata": {},
   "outputs": [],
   "source": [
    "family_photos  = df.groupby(\"family\").size().sort_values(ascending=False)\n",
    "family_species = df.drop_duplicates(\"species\").groupby(\"family\").size()\n",
    "\n",
    "fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(16, 12))\n",
    "\n",
    "# Family dual-axis\n",
    "top_fams = family_photos.head(20).index\n",
    "x = np.arange(len(top_fams))\n",
    "ax1t = ax1.twinx()\n",
    "ax1.bar(x, family_photos[top_fams].values, alpha=0.7, color=\"#3498db\")\n",
